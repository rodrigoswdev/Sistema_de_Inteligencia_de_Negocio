# Aplicación
NEXT_PUBLIC_APP_NAME=SIBI-CBN
AUTH_SECRET=cambie-por-un-secreto-privado-de-al-menos-32-caracteres
DEMO_MODE=true

# Supabase Auth: valores públicos de Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Solo servidor: necesaria para RF-02 (crear usuarios de Supabase Auth)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
